{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c blue,green,yellow \"npm:dev:web\" \"npm:server:dev\" \"npm:worker:dev\"",
    "dev:web": "vite",
    "server:dev": "tsx --watch --env-file=.env.local server/index.ts",
    "worker:dev": "tsx --watch --env-file=.env.local worker/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json && cp -r server/data server-dist/server/",
    "build:all": "npm run build && npm run build:server",
    "start:server": "node --enable-source-maps server-dist/server/index.js",
    "start:worker": "node --enable-source-maps server-dist/worker/index.js",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "db:reset:dev": "psql \"$DATABASE_URL\" -f db/schema.sql -f db/migrations/001_segmented_courses.sql -f db/migrations/002_cert_columns.sql -f db/migrations/003_cert_jobs.sql -f db/migrations/004_oauth_state_payload.sql -f db/migrations/005_segment_progress.sql",
    "backfill:certs": "tsx --env-file=.env.local scripts/backfill-certs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@emailjs/browser": "^4.4.1",
    "@google/genai": "^1.51.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@vimeo/player": "^2.30.4",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "pdfjs-dist": "^5.6.205",
    "puppeteer-core": "^24.43.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-image-crop": "^11.0.10",
    "recharts": "^3.8.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/vimeo__player": "^2.18.3",
    "@types/ws": "^8.18.1",
    "@vimeo/vimeo": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "pg": "^8.20.0",
    "resend": "^6.12.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.6"
  }
}
