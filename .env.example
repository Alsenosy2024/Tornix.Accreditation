# --- Frontend (baked into Vite bundle) -------------------------------
# NOTE: Vite inlines this into the client bundle at build time (see vite.config.ts).
# That means it's visible in the deployed JS. Restrict the key in Google AI Studio
# to HTTP referrer = your Netlify domain + the Generative Language API only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Server-side (Netlify Functions only) ---------------------------
# Netlify Database injects NETLIFY_DATABASE_URL automatically — you don't set it.
# Local dev: netlify dev tunnels into the local Neon dev database.

# Google OAuth client — used by /api/auth/google/start + callback.
# Create one at: https://console.cloud.google.com/apis/credentials
#   App type: Web application
#   Authorized redirect URIs:
#     https://<your-netlify-domain>/api/auth/google/callback
#     http://localhost:8888/api/auth/google/callback   (for `netlify dev`)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# Random 64-byte base64 string used to sign session cookies.
# Generate locally: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET="long-random-secret"

# Resend API key (used by /api/send-email).
RESEND_API_KEY="re_xxx"

# Optional override for the "from" address. Defaults to onboarding@resend.dev.
# Use a domain verified in Resend, e.g. no-reply@yourdomain.com
RESEND_FROM_EMAIL=""
